# Leave OPENAI_API_KEY empty to run fully offline with the deterministic mock provider.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Leave DATABASE_URL empty to use the in-memory store (no Docker needed).
# With Docker: docker compose up -d  ->  DATABASE_URL=postgres://rag:rag@localhost:5433/rag
DATABASE_URL=

PORT=3000
